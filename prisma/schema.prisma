generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model brands {
  id        Int      @id @default(autoincrement())
  name      String?  @db.VarChar(255)
  published Boolean?
  createdAt DateTime @db.Date
  updatedAt DateTime @db.Date
}

model categories {
  id        Int      @id @default(autoincrement())
  name      String?  @db.VarChar(255)
  image     String?  @db.VarChar(255)
  published Boolean?
  createdAt DateTime @db.Date
  updatedAt DateTime @db.Date
}

model images {
  id        Int       @id @default(autoincrement())
  name      String?   @db.VarChar(255)
  productId Int?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  products? @relation(fields: [productId], references: [id], onDelete: Cascade, map: "images_ibfk_1")
  @@index([productId], map: "images_ibfk_1")
}

model products {
  id              Int      @id @default(autoincrement())
  name            String?  @db.VarChar(255)
  categorieId     Int?
  description     String?  @db.Text
  brandId         Int?
  tag             String?  @db.VarChar(255)
  metaDescription String?  @db.Text
  metaKeywords    String?  @db.VarChar(255)
  published       Boolean? @default(false)
  createdAt  DateTime @default(now())
  UpdatedAt DateTime @default(now()) @updatedAt
  images          images[]
  @@index([brandId], map: "brandId")
  @@index([categorieId], map: "products_ibfk_1")
}

model clients {
  id        Int       @id @default(autoincrement())
  name      String?   @db.VarChar(255)
  address   String?   @db.VarChar(255)
  contact   String?   @db.VarChar(255)
  email     String?   @db.VarChar(255)
  createdAt  DateTime @default(now())
  UpdatedAt DateTime @default(now()) @updatedAt
}


model offers {
  id        Int       @id @default(autoincrement())
  product   String?   @db.VarChar(255)
  price     String?   @db.VarChar(255)
  vendorId  Int?
  date      DateTime? @db.Date
  createdAt  DateTime @default(now())
  UpdatedAt DateTime @default(now()) @updatedAt
  @@index([vendorId], map: "vendorId")
}

model users {
  id        Int        @id @default(autoincrement())
  name      String?    @db.VarChar(255)
  email     String?    @db.VarChar(255)
  password  String?    @db.VarChar(255)
  createdAt  DateTime @default(now())
  UpdatedAt DateTime @default(now()) @updatedAt
}

model vendors {
  id        Int       @id @default(autoincrement())
  name      String?   @db.VarChar(255)
  address   String?   @db.VarChar(255)
  contact   String?   @db.VarChar(255)
  email     String?   @db.VarChar(255)
  createdAt  DateTime @default(now())
  UpdatedAt DateTime @default(now()) @updatedAt
}

model Employees {
  id        Int      @id @default(autoincrement())
  name      String?
  email     String?
  phone     String?
  role_id   Int?     // Mengganti 'role String?' menjadi foreign key (Int)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  roleData  Roles?   @relation(fields: [role_id], references: [id])
}

model Roles {
  id        Int        @id @default(autoincrement())
  role      String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  // Relasi balik (satu Role bisa dimiliki banyak Employes)
  employees  Employees[]
}

model verification_tokens {
  token      String   @id @db.VarChar(255)
  identifier String   @db.VarChar(255)
  expires    DateTime @db.DateTime(0)
}
